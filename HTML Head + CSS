<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rum Pum - Taste the Magic | 3D Product Showcase</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&family=Noto+Sans+Devanagari:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --rp-red: #E31837;
            --rp-yellow: #FFD700;
            --rp-orange: #FF6B00;
            --rp-dark: #1a1a2e;
            --rp-darker: #0f0f1a;
            --rp-card: #16213e;
            --rp-gold: #D4AF37;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Poppins', 'Noto Sans Devanagari', sans-serif;
            background: var(--rp-darker);
            color: #fff;
            overflow-x: hidden;
        }
        #steamCanvas {
            position: fixed; top: 0; left: 0;
            width: 100%; height: 100%;
            pointer-events: none; z-index: 1; opacity: 0.4;
        }
        nav {
            position: fixed; top: 0; width: 100%;
            background: rgba(15,15,26,0.95);
            backdrop-filter: blur(20px); z-index: 1000;
            padding: 15px 5%;
            display: flex; justify-content: space-between; align-items: center;
            border-bottom: 1px solid rgba(255,215,0,0.1);
        }
        .logo {
            font-size: 28px; font-weight: 900;
            background: linear-gradient(135deg, var(--rp-red), var(--rp-yellow));
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        }
        .logo span { font-weight: 300; font-size: 14px; display: block; color: #aaa; -webkit-text-fill-color: #aaa; }
        .nav-links { display: flex; gap: 30px; list-style: none; }
        .nav-links a { color: #ccc; text-decoration: none; font-weight: 500; transition: 0.3s; position: relative; }
        .nav-links a:hover { color: var(--rp-yellow); }
        .nav-links a::after {
            content: ''; position: absolute; bottom: -5px; left: 0;
            width: 0; height: 2px;
            background: linear-gradient(90deg, var(--rp-red), var(--rp-yellow));
            transition: 0.3s;
        }
        .nav-links a:hover::after { width: 100%; }
        .cart-icon {
            position: relative; cursor: pointer; font-size: 24px;
            padding: 8px 15px;
            background: linear-gradient(135deg, var(--rp-red), var(--rp-orange));
            border-radius: 50px; transition: 0.3s;
        }
        .cart-icon:hover { transform: scale(1.1); box-shadow: 0 5px 20px rgba(227,24,55,0.4); }
        .cart-count {
            position: absolute; top: -5px; right: -5px;
            background: var(--rp-yellow); color: #000;
            font-size: 12px; font-weight: 700;
            width: 22px; height: 22px; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
        }
        .hero {
            min-height: 100vh; display: flex; align-items: center; justify-content: center;
            position: relative; padding-top: 80px;
            background: radial-gradient(ellipse at center, rgba(227,24,55,0.15) 0%, transparent 70%);
        }
        .hero-content { text-align: center; z-index: 10; max-width: 900px; padding: 0 20px; }
        .hero-badge {
            display: inline-block; padding: 8px 25px;
            background: linear-gradient(135deg, rgba(227,24,55,0.3), rgba(255,107,0,0.3));
            border: 1px solid rgba(255,215,0,0.3); border-radius: 50px;
            font-size: 14px; color: var(--rp-yellow); margin-bottom: 25px;
            letter-spacing: 2px; text-transform: uppercase;
        }
        .hero h1 {
            font-size: clamp(40px, 8vw, 80px); font-weight: 900; line-height: 1.1; margin-bottom: 20px;
            background: linear-gradient(135deg, #fff 0%, var(--rp-yellow) 50%, var(--rp-red) 100%);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            animation: heroGlow 3s ease-in-out infinite alternate;
        }
        @keyframes heroGlow {
            0% { filter: drop-shadow(0 0 20px rgba(227,24,55,0.3)); }
            100% { filter: drop-shadow(0 0 40px rgba(255,215,0,0.5)); }
        }
        .hero h1 .highlight {
            background: linear-gradient(135deg, var(--rp-red), var(--rp-orange));
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        }
        .hero p { font-size: 18px; color: #aaa; margin-bottom: 40px; line-height: 1.8; }
        .hero p strong { color: var(--rp-yellow); }
        .hero-buttons { display: flex; gap: 20px; justify-content: center; flex-wrap: wrap; }
        .btn-primary {
            padding: 15px 40px;
            background: linear-gradient(135deg, var(--rp-red), var(--rp-orange));
            color: #fff; border: none; border-radius: 50px;
            font-size: 16px; font-weight: 600; cursor: pointer; transition: 0.3s;
            text-decoration: none; display: inline-flex; align-items: center; gap: 10px;
            box-shadow: 0 10px 30px rgba(227,24,55,0.3);
        }
        .btn-primary:hover { transform: translateY(-3px); box-shadow: 0 15px 40px rgba(227,24,55,0.5); }
        .btn-secondary {
            padding: 15px 40px; background: transparent; color: var(--rp-yellow);
            border: 2px solid rgba(255,215,0,0.3); border-radius: 50px;
            font-size: 16px; font-weight: 600; cursor: pointer; transition: 0.3s;
            text-decoration: none; display: inline-flex; align-items: center; gap: 10px;
        }
        .btn-secondary:hover { border-color: var(--rp-yellow); background: rgba(255,215,0,0.1); transform: translateY(-3px); }
        .hero-3d-product {
            position: absolute; width: 300px; height: 300px;
            right: 10%; top: 50%; transform: translateY(-50%);
            perspective: 1000px; z-index: 5;
        }
        .product-3d {
            width: 100%; height: 100%; position: relative;
            transform-style: preserve-3d;
            animation: rotate3d 15s linear infinite;
        }
        @keyframes rotate3d {
            0% { transform: rotateY(0deg) rotateX(10deg); }
            100% { transform: rotateY(360deg) rotateX(10deg); }
        }
        .product-3d-face {
            position: absolute; width: 200px; height: 280px;
            left: 50px; top: 10px;
            background: linear-gradient(135deg, var(--rp-red), var(--rp-orange));
            border-radius: 15px; display: flex; align-items: center; justify-content: center;
            font-size: 24px; font-weight: 900;
            border: 3px solid rgba(255,215,0,0.5);
            box-shadow: 0 0 50px rgba(227,24,55,0.5);
        }
        .product-3d-face:nth-child(1) { transform: translateZ(30px); }
        .product-3d-face:nth-child(2) { transform: rotateY(90deg) translateZ(30px); width: 60px; left: 120px; background: linear-gradient(135deg, var(--rp-orange), var(--rp-yellow)); }
        .product-3d-face:nth-child(3) { transform: rotateY(180deg) translateZ(30px); }
        .product-3d-face:nth-child(4) { transform: rotateY(-90deg) translateZ(30px); width: 60px; left: 120px; background: linear-gradient(135deg, var(--rp-orange), var(--rp-yellow)); }
        .product-3d-face:nth-child(5) { transform: rotateX(90deg) translateZ(30px); height: 60px; top: 120px; background: var(--rp-yellow); }
        .product-3d-face:nth-child(6) { transform: rotateX(-90deg) translateZ(250px); height: 60px; top: 120px; background: var(--rp-red); }
        .section { padding: 100px 5%; position: relative; z-index: 10; }
        .section-header { text-align: center; margin-bottom: 60px; }
        .section-tag {
            display: inline-block; padding: 5px 20px;
            background: rgba(227,24,55,0.2); border: 1px solid rgba(227,24,55,0.3);
            border-radius: 50px; color: var(--rp-red);
            font-size: 13px; font-weight: 600; text-transform: uppercase;
            letter-spacing: 2px; margin-bottom: 15px;
        }
        .section-title {
            font-size: clamp(28px, 5vw, 48px); font-weight: 800; margin-bottom: 15px;
            background: linear-gradient(135deg, #fff, var(--rp-yellow));
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        }
        .section-subtitle { color: #888; font-size: 16px; max-width: 600px; margin: 0 auto; line-height: 1.7; }
        .product-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 30px; max-width: 1400px; margin: 0 auto;
        }
        .product-card {
            background: linear-gradient(145deg, var(--rp-card), rgba(22,33,62,0.5));
            border-radius: 20px; overflow: hidden;
            border: 1px solid rgba(255,215,0,0.1);
            transition: 0.5s; position: relative;
            transform-style: preserve-3d; perspective: 1000px;
        }
        .product-card::before {
            content: ''; position: absolute; top: 0; left: -100%;
            width: 100%; height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,215,0,0.1), transparent);
            transition: 0.5s;
        }
        .product-card:hover::before { left: 100%; }
        .product-card:hover {
            transform: translateY(-10px) rotateX(5deg);
            border-color: rgba(255,215,0,0.3);
            box-shadow: 0 20px 60px rgba(227,24,55,0.2), 0 0 30px rgba(255,215,0,0.1);
        }
        .product-image-wrap {
            height: 220px;
            background: linear-gradient(135deg, rgba(227,24,55,0.1), rgba(255,107,0,0.1));
            display: flex; align-items: center; justify-content: center;
            position: relative; overflow: hidden;
        }
        .product-image-wrap img {
            max-width: 70%; max-height: 80%; object-fit: contain;
            transition: 0.5s;
            filter: drop-shadow(0 10px 20px rgba(0,0,0,0.3));
        }
        .product-card:hover .product-image-wrap img {
            transform: scale(1.1) rotate(-5deg);
            filter: drop-shadow(0 15px 30px rgba(227,24,55,0.3));
        }
        .product-badge {
            position: absolute; top: 15px; left: 15px;
            padding: 5px 15px;
            background: linear-gradient(135deg, var(--rp-red), var(--rp-orange));
            border-radius: 50px; font-size: 11px; font-weight: 700;
            text-transform: uppercase; letter-spacing: 1px;
        }
        .product-badge.bestseller { background: linear-gradient(135deg, var(--rp-yellow), #FFA500); color: #000; }
        .product-badge.new { background: linear-gradient(135deg, #00C853, #00E676); }
        .product-badge.kids { background: linear-gradient(135deg, #FF4081, #F50057); }
        .product-info { padding: 25px; }
        .product-name { font-size: 18px; font-weight: 700; margin-bottom: 8px; color: #fff; }
        .product-desc { font-size: 13px; color: #888; margin-bottom: 15px; line-height: 1.5; }
        .product-price-row { display: flex; justify-content: space-between; align-items: center; }
        .product-price { font-size: 24px; font-weight: 800; color: var(--rp-yellow); }
        .product-price .currency { font-size: 16px; }
        .add-to-cart {
            padding: 10px 25px;
            background: linear-gradient(135deg, var(--rp-red), var(--rp-orange));
            border: none; border-radius: 50px; color: #fff;
            font-weight: 600; cursor: pointer; transition: 0.3s; font-size: 14px;
        }
        .add-to-cart:hover { transform: scale(1.05); box-shadow: 0 5px 20px rgba(227,24,55,0.4); }
        .exploded-section {
            background: linear-gradient(180deg, var(--rp-darker), var(--rp-dark));
            padding: 100px 5%; position: relative; overflow: hidden;
        }
        .exploded-section::before {
            content: ''; position: absolute;
            width: 600px; height: 600px;
            background: radial-gradient(circle, rgba(227,24,55,0.1), transparent 70%);
            top: 50%; left: 50%; transform: translate(-50%, -50%);
        }
        .exploded-container {
            max-width: 1200px; margin: 0 auto;
            display: grid; grid-template-columns: 1fr 1fr;
            gap: 60px; align-items: center;
            position: relative; z-index: 10;
        }
        .exploded-visual { position: relative; height: 500px; display: flex; align-items: center; justify-content: center; }
        .noodle-layer {
            position: absolute; width: 300px; height: 40px; border-radius: 20px;
            transition: 1s cubic-bezier(0.68, -0.55, 0.265, 1.55);
            box-shadow: 0 5px 20px rgba(0,0,0,0.3);
        }
        .layer-1 { background: linear-gradient(90deg, #FFD700, #FFA500); top: 40%; }
        .layer-2 { background: linear-gradient(90deg, #FF6B00, #FF8C00); top: 40%; }
        .layer-3 { background: linear-gradient(90deg, #E31837, #FF4444); top: 40%; }
        .layer-4 { background: linear-gradient(90deg, #4CAF50, #8BC34A); top: 40%; }
        .layer-5 { background: linear-gradient(90deg, #2196F3, #03A9F4); top: 40%; }
        .exploded-visual.active .layer-1 { transform: translateY(-120px); }
        .exploded-visual.active .layer-2 { transform: translateY(-60px); }
        .exploded-visual.active .layer-3 { transform: translateY(0); }
        .exploded-visual.active .layer-4 { transform: translateY(60px); }
        .exploded-visual.active .layer-5 { transform: translateY(120px); }
        .explode-btn {
            position: absolute; bottom: 30px;
            padding: 15px 40px;
            background: linear-gradient(135deg, var(--rp-red), var(--rp-orange));
            border: none; border-radius: 50px; color: #fff;
            font-size: 16px; font-weight: 700; cursor: pointer; transition: 0.3s;
            box-shadow: 0 10px 30px rgba(227,24,55,0.3);
        }
        .explode-btn:hover { transform: scale(1.05); }
        .exploded-text h2 {
            font-size: 36px; font-weight: 800; margin-bottom: 20px;
            background: linear-gradient(135deg, #fff, var(--rp-yellow));
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        }
        .exploded-text p { color: #aaa; font-size: 16px; line-height: 1.8; margin-bottom: 30px; }
        .ingredient-list { list-style: none; }
        .ingredient-list li {
            padding: 12px 0; border-bottom: 1px solid rgba(255,255,255,0.05);
            display: flex; align-items: center; gap: 15px;
            color: #ccc; font-size: 15px;
        }
        .ingredient-list li::before {
            content: ''; width: 30px; height: 30px; border-radius: 50%; flex-shrink: 0;
        }
        .ingredient-list li:nth-child(1)::before { background: linear-gradient(135deg, #FFD700, #FFA500); }
        .ingredient-list li:nth-child(2)::before { background: linear-gradient(135deg, #FF6B00, #FF8C00); }
        .ingredient-list li:nth-child(3)::before { background: linear-gradient(135deg, #E31837, #FF4444); }
        .ingredient-list li:nth-child(4)::before { background: linear-gradient(135deg, #4CAF50, #8BC34A); }
        .ingredient-list li:nth-child(5)::before { background: linear-gradient(135deg, #2196F3, #03A9F4); }
        .combo-section { padding: 100px 5%; background: var(--rp-darker); }
        .combo-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 30px; max-width: 1200px; margin: 0 auto;
        }
        .combo-card {
            background: linear-gradient(145deg, var(--rp-card), rgba(22,33,62,0.3));
            border-radius: 25px; padding: 40px;
            border: 2px solid rgba(255,215,0,0.1);
            position: relative; overflow: hidden; transition: 0.5s;
        }
        .combo-card:hover {
